<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="llm_robot">

  <!-- ============================================== -->
  <!-- Robot Properties                               -->
  <!-- ============================================== -->
  <xacro:property name="base_length" value="0.40" />
  <xacro:property name="base_width"  value="0.30" />
  <xacro:property name="base_height" value="0.15" />
  <xacro:property name="ground_clearance" value="0.025" />
  <xacro:property name="base_mass"   value="5.0" />

  <xacro:property name="wheel_radius" value="0.075" />
  <xacro:property name="wheel_width"  value="0.04" />
  <xacro:property name="wheel_mass"   value="1.0" />
  <!-- Move the wheels slightly towards the back of the chassis -->
  <xacro:property name="wheel_x_offset" value="-0.10" />
  <!-- Place wheels exactly outside the chassis on the Y axis -->
  <!-- 0.15 (half chassis) + 0.02 (half wheel) + 0.005 (clearance) = 0.175 -->
  <xacro:property name="wheel_y_offset" value="0.175" />

  <!-- Caster Wheel Properties -->
  <xacro:property name="caster_radius" value="0.04" />
  <xacro:property name="caster_mass"   value="0.5" />
  <xacro:property name="caster_x_offset" value="0.16" />
  <xacro:property name="caster_z_offset" value="-0.035" />

  <!-- ============================================== -->
  <!-- Macros                                         -->
  <!-- ============================================== -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (w*w + h*h)}" ixy="0.0" ixz="0.0" 
               iyy="${(m/12) * (l*l + h*h)}" iyz="0.0" 
               izz="${(m/12) * (l*l + w*w)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0" 
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0" 
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5) * m * r * r}" ixy="0.0" ixz="0.0" 
               iyy="${(2/5) * m * r * r}" iyz="0.0" 
               izz="${(2/5) * m * r * r}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================== -->
  <!-- Links & Joints                                 -->
  <!-- ============================================== -->
  
  <!-- Base Footprint: Massless reference link on the ground -->
  <link name="base_footprint"/>

  <!-- Joint connecting footprint to base_link -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- The origin of base_link is at its volumetric center, so we raise it by half its height -->
    <origin xyz="0 0 ${(base_height / 2) + ground_clearance}" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <!-- Visual Geometry -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>

    <!-- Collision Geometry -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <!-- Inertial Properties -->
    <xacro:box_inertia m="${base_mass}" l="${base_length}" w="${base_width}" h="${base_height}"/>
  </link>

  <!-- Drive Wheel Macro -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <!-- Rotate the cylinder by -90 degrees on X to align it with the Y axis -->
        <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      
      <!-- Rotate inertial frame identically to keep standard cylinder inertia logic valid -->
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
      </xacro:cylinder_inertia>
    </link>
    
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <!-- Wheel joint Z=0 relative to base_link (which is +0.075m above ground). 
           Radius is 0.075m, making the bottom perfectly touch the ground! -->
      <origin xyz="${wheel_x_offset} ${y_reflect * wheel_y_offset} ${-ground_clearance}" rpy="0 0 0"/>
      <!-- Rotation axis is purely along the Y axis -->
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Instantiate Left and Right Wheels -->
  <xacro:drive_wheel prefix="left" y_reflect="1" />
  <xacro:drive_wheel prefix="right" y_reflect="-1" />

  <!-- Caster Wheel -->
  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <!-- Caster Joint -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <!-- Positioned at the rear. Z=-0.035 relative to base_link (which is at Z=0.075 absolute).
         So caster center is at absolute Z = 0.04. Caster radius is 0.04. 
         Therefore, the bottom of the caster perfectly touches the ground at Z=0. -->
    <origin xyz="${caster_x_offset} 0.0 ${caster_z_offset - ground_clearance}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- LiDAR Sensor                                   -->
  <!-- ============================================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.195" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>
      <ambient>0.0 0.0 0.0 1.0</ambient>
      <diffuse>0.0 0.0 0.0 1.0</diffuse>
    </material>
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- ============================================== -->
  <!-- Gazebo Materials                               -->
  <!-- ============================================== -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.2 0.2 0.8 1.0</ambient>
      <diffuse>0.2 0.2 0.8 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="left_wheel">
    <material>
      <ambient>0.1 0.1 0.1 1.0</ambient>
      <diffuse>0.1 0.1 0.1 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="right_wheel">
    <material>
      <ambient>0.1 0.1 0.1 1.0</ambient>
      <diffuse>0.1 0.1 0.1 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="caster_wheel">
    <material>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <diffuse>0.5 0.5 0.5 1.0</diffuse>
    </material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ============================================== -->
  <!-- ROS 2 Control (Hardware Interface)             -->
  <!-- ============================================== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Control Plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find llm_robot_gazebo)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
